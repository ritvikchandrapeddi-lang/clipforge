# ==============================================================================
# ClipForge Enterprise Environment Configuration
# ==============================================================================

NODE_ENV=development

# Web Instances Ports (web1: 4001, web2: 4002)
PORT=4001
INSTANCE_ID=web-instance-1

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Set DATABASE_URL to your PostgreSQL instance (local or managed cloud instance)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=clipforge
POSTGRES_USER=clipforge_user
POSTGRES_PASSWORD=clipforge_secret
DATABASE_URL=postgresql://clipforge_user:clipforge_secret@127.0.0.1:5432/clipforge

# ------------------------------------------------------------------------------
# 2. RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
# Standard AMQP URI for durable exchange and queue distribution
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

# ------------------------------------------------------------------------------
# 3. Redis Shared State & Pub/Sub Configuration
# ------------------------------------------------------------------------------
# Real Redis instance for cluster-wide progress, quotas, and real-time fan-out
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. Storage Directories (Shared across Web instances and Workers)
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
UPLOAD_TEMP_DIR=./storage/temp_chunks
PROCESSED_DIR=./storage/processed
DATA_DIR=./storage/data

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
# Direct standalone ports or Nginx load balancer port (:4000)
VITE_API_URL=http://localhost:4001/api
VITE_WS_URL=ws://localhost:4001/ws

# ------------------------------------------------------------------------------
# 6. Worker Fleet Concurrency & Retry Settings
# ------------------------------------------------------------------------------
VALIDATION_WORKER_CONCURRENCY=2
CONVERSION_WORKER_CONCURRENCY=2
THUMBNAIL_WORKER_CONCURRENCY=2
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

