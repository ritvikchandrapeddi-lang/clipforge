# ==============================================================================
# ClipForge Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=4001

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clipforge
POSTGRES_USER=clipforge_user
POSTGRES_PASSWORD=clipforge_secret
DATABASE_URL=postgresql://clipforge_user:clipforge_secret@localhost:5432/clipforge

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# In-Memory Cache & Real-Time Sync (Redis)
REDIS_URL=redis://localhost:6379

# Storage Directory (Shared between Web instances and Workers)
STORAGE_DIR=./storage
UPLOAD_TEMP_DIR=./storage/temp_chunks
PROCESSED_DIR=./storage/processed

# Frontend Client Configuration
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws

# Worker Scaling & Concurrency Defaults
VALIDATION_WORKER_CONCURRENCY=2
CONVERSION_WORKER_CONCURRENCY=2
THUMBNAIL_WORKER_CONCURRENCY=2
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

